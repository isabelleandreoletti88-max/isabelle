# Hostinger (Apache)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Une seule adresse pour le site : https://atelier-isabelle.fr (sans www).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Adresses en double : redirection permanente vers la page de référence.
  RewriteRule ^creations/?$ /boutique [R=301,L]
  RewriteRule ^collections/?$ /boutique [R=301,L]
  RewriteRule ^confidentialite/?$ /politique-confidentialite [R=301,L]
  RewriteRule ^mentions-legales-legacy/?$ /mentions-legales [R=301,L]
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Pages pré-générées (contenu lisible par les moteurs et les réseaux sociaux) : /boutique -> boutique.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Toutes les autres routes React Router -> application sans contenu pré-généré
  # (spa.html, créé par npm run build:seo ; index.html après un simple npm run build).
  RewriteRule ^(index|spa)\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/spa.html -f
  RewriteRule . /spa.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Les pages HTML ne doivent jamais rester en cache : sinon un navigateur garde l'ancienne version
# du site après une mise à jour. Les fichiers de assets/ portent une empreinte dans leur nom
# et les images changent de nom quand elles changent : ils peuvent être gardés longtemps.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>
