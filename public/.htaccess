# Hostinger (Apache) : renvoyer toutes les routes React Router vers index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html ne doit jamais rester en cache : sinon un navigateur garde l'ancienne version
# du site après une mise à jour. Les fichiers de assets/ portent une empreinte dans leur nom
# et peuvent donc être gardés longtemps.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
